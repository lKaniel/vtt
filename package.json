{
  "name": "vtt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./packages/server --filter ./packages/client dev",
    "build": "pnpm --filter @vtt/client build",
    "start": "pnpm --filter @vtt/server start",
    "check-game": "pnpm --filter @vtt/server check-game",
    "check-world": "pnpm check-game",
    "migrate-world": "pnpm --filter @vtt/server migrate-world",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "quality": "pnpm coverage && fallow",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm quality && pnpm check-game",
    "import-foundry": "pnpm --filter @vtt/server import-foundry"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fallow": "3.37.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
}
