{
  "name": "vtt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./packages/server --filter ./packages/client dev",
    "build": "pnpm --filter @vtt/client build",
    "start": "pnpm --filter @vtt/server start",
    "check-world": "pnpm --filter @vtt/server check-world",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "@types/node": "^22.18.0"
  },
  "packageManager": "pnpm@10.28.0"
}
