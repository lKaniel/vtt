# /opt/vtt/.env on the VPS. Never commit the real one.
VTT_DOMAIN=vtt.example.com
# The admin password for the lobby (Setup).
VTT_ADMIN_PASSWORD=change-me
# Optional: a key for the Claude bridge (POST /mcp) that sits as the home game's GM.
# VTT_MCP_KEY=
# Optional: nightly backups of every game off the server (docs/deploy.md, Backups).
# VTT_BACKUP_S3_ENDPOINT=https://fsn1.your-objectstorage.com
# VTT_BACKUP_S3_BUCKET=vtt-backups
# VTT_BACKUP_S3_REGION=fsn1
# VTT_BACKUP_S3_KEY=
# VTT_BACKUP_S3_SECRET=
